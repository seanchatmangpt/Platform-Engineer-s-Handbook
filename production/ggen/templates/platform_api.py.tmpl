from production.runtime.generated_platform import PlatformBroker, ProductionActuator
from production.runtime.persistent_ledger import SqliteReceiptLedger

log = logging.getLogger("platform_api")
logging.basicConfig(level=os.getenv("LOG_LEVEL", "INFO"))

def required(name: str) -> str:
    value = os.getenv(name, "").strip()
    if not value:
        raise RuntimeError(f"required environment variable is not set: {name}")
    return value

ledger = SqliteReceiptLedger(required("PLATFORM_RECEIPT_DB"))
broker = PlatformBroker(
    ProductionActuator(),
    source_identity=required("PLATFORM_SOURCE_IDENTITY"),
    base_identity=required("PLATFORM_BASE_IDENTITY"),
    environment_identity=required("PLATFORM_ENVIRONMENT_IDENTITY"),
    authority=required("PLATFORM_AUTHORITY"),
    ledger=ledger,
)
api_token = required("PLATFORM_API_TOKEN")

class Handler(BaseHTTPRequestHandler):
    server_version = "PEHPlatformAPI/1.0"

    def _json(self, status: int, payload: dict):
        body = json.dumps(payload, sort_keys=True, separators=(",", ":"), default=str).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _authorized(self) -> bool:
        header = self.headers.get("Authorization", "")
        candidate = header[7:] if header.startswith("Bearer ") else ""
        return hmac.compare_digest(candidate, api_token)

    def do_GET(self):
        if self.path != "/healthz":
            self._json(404, {"error": "not_found"}); return
        replay_ok = ledger.replay()
        self._json(200 if replay_ok else 503, {"status": "ok" if replay_ok else "receipt_replay_failed", "receipt_head": ledger.head})

    def do_POST(self):
        if self.path != "/v1/intents":
            self._json(404, {"error": "not_found"}); return
        if not self._authorized():
