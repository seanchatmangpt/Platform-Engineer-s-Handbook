            request = json.loads(self.rfile.read(length).decode("utf-8"))
            for key in ("capability_id", "intent_id", "subject", "payload"):
                if key not in request:
                    raise ValueError(f"missing field: {key}")
            if not isinstance(request["payload"], dict):
