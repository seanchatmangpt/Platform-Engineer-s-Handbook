peh:platform-control-plane a f5:ArchitectureAsset ; f5:assetId "platform-control-plane" ; f5:title "Platform Engineering Production Control Plane" ; f5:owner "platform-engineering" ; f5:criticality f5:Tier0 ; f5:lifecycleState f5:Admitted ; f5:realizesCapability peh:platform-product-governance, peh:runtime-gitops, peh:identity-security, peh:observability, peh:developer-experience, peh:developer-portal, peh:onboarding, peh:software-delivery, peh:infrastructure-service, peh:starter-kits, peh:policy-compliance, peh:finops-scaling, peh:resilience, peh:ai-augmentation ; f5:deployedIn peh:us-west, peh:us-east, peh:us-central ; f5:hasSlo peh:slo ; f5:hasCapacityEnvelope peh:capacity ; f5:hasReplicationPolicy peh:replication ; f5:hasIdentityPolicy peh:identity ; f5:hasKmsPolicy peh:kms ; f5:hasObservabilityPolicy peh:otel ; f5:hasSupervisionPolicy peh:supervision .
peh:slo a f5:SloDefinition ; f5:sloId "platform-availability" ; f5:sliKind "availability" ; f5:direction "at-least" ; f5:target 99.99 ; f5:windowSeconds 2592000 ; f5:minimumSamples 1000 ; f5:fastBurnThreshold 14.4 .
peh:capacity a f5:CapacityEnvelope ; f5:minReplicas 3 ; f5:maxReplicas 64 ; f5:unitCapacity 1000.0 ; f5:reserveRatio 0.20 .
peh:replication a f5:ReplicationPolicy ; f5:replicationMode f5:Strong ; f5:replicatesTo peh:us-west, peh:us-east, peh:us-central ; f5:writeQuorum 2 ; f5:readQuorum 2 ; f5:rpoSeconds 0 ; f5:rtoSeconds 60 ; f5:allowedJurisdiction "US" .
peh:identity a f5:IdentityPolicy ; f5:trustDomain "platform.chatman.dev" ; f5:allowedSpiffeId "spiffe://platform.chatman.dev/ns/platform-system/sa/control-plane" ; f5:mtlsRequired true ; f5:maxSvidTtlSeconds 3600 ; f5:workloadAttestationRequired true .
peh:kms a f5:KmsPolicy ; f5:kmsProvider "cloud-kms" ; f5:keyAlias "alias/platform-production" ; f5:rotationDays 30 ; f5:hsmBacked true ; f5:envelopeEncryption true ; f5:decryptAuditRequired true ; f5:breakGlassDualControl true .
peh:otel a f5:ObservabilityPolicy ; f5:logsRequired true ; f5:metricsRequired true ; f5:tracesRequired true ; f5:profilesRequired true ; f5:correlationIdsRequired true ; f5:redactionRequired true ; f5:retentionDays 400 ; f5:otlpEndpointClass "regional-collector" .
peh:supervision a f5:SupervisionPolicy ; f5:restartStrategy "one-for-one" ; f5:maxRestarts 5 ; f5:restartWindowSeconds 60 ; f5:distributionEnabled true ; f5:telemetryEnabled true ; f5:childSpecificationCount 14 .
peh:production-promotion a f5:PromotionGate ; f5:gateId "platform-production" ; f5:fromState f5:Admitted ; f5:toState f5:Active ; f5:requiredEvidence "threat-model" ; f5:minimumApprovals 2 ; f5:requireSloGreen true ; f5:requireReceiptReplay true ; f5:requireSecurityControls true .
peh:autonomics a f5:AutonomicPolicy ; f5:autonomicPolicyId "platform-autonomics" ; f5:broker "BRCE" ; f5:directActuation false ; f5:maxParallelism 32 ; f5:receiptAlgorithm "blake3" .
peh:platform-dflss a f5:DflssProgram ; f5:dflssId "platform-dflss" ; f5:defineEvidence "d" ; f5:measureEvidence "m" ; f5:analyzeEvidence "a" ; f5:designEvidence "g" ; f5:verifyEvidence "v" .
peh:knhk-adapter a f5:WorkflowEngineAdapter ; f5:adapterId "knhk-rdf-v1" ; f5:engineName "KNHK" ; f5:adapterProtocol "rdf-workflow-v1" ; f5:inputGraphClass "f5:EnterpriseArchitectureProgram" ; f5:outputReceiptClass "ggen.architecture.receipt.v1" ; f5:receiptRequired true .
peh:hot-path a f5:ExecutionPath ; f5:executionPath f5:Hot ; f5:maxTriples 8 ; f5:maxJoins 0 ; f5:simplePredicatesRequired true . peh:warm-path a f5:ExecutionPath ; f5:executionPath f5:Warm ; f5:maxTriples 1000 ; f5:maxJoins 4 ; f5:simplePredicatesRequired true . peh:cold-path a f5:ExecutionPath ; f5:executionPath f5:Cold ; f5:maxTriples 1000000 ; f5:maxJoins 64 ; f5:simplePredicatesRequired false .
