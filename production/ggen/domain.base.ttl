peh:channel-api a peh:InterfaceChannel ; peh:channelId "api" ; peh:protocol "https+json" ; peh:purpose "machine" ; peh:ambientExecutionAuthority false .
peh:channel-events a peh:InterfaceChannel ; peh:channelId "events" ; peh:protocol "asyncapi" ; peh:purpose "event" ; peh:ambientExecutionAuthority false .
peh:channel-mcp a peh:InterfaceChannel ; peh:channelId "mcp" ; peh:protocol "json-rpc" ; peh:purpose "model-context" ; peh:ambientExecutionAuthority false .
